# Uzum Market qoldiq sinxron worker — VPS uchun systemd unit namunasi.
# Smartup balans (001 − 002) → masking (>= cap → cap, aks holda 0) → Uzum FBS.
# Kerakli env (api.env da): UZUM_API_TOKEN, SMARTUP_BASIC_USER/PASS.
# Loglar: journalctl -u wms-uzum-worker -f

[Unit]
Description=WMS Uzum Market stock sync worker
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=@WMS_DEPLOY_USER@
Group=@WMS_DEPLOY_USER@
WorkingDirectory=@WMS_DEPLOY_DIR@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/wms/api.env

ExecStart=@WMS_VENV_BIN@/python uzum_worker.py
Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=wms-uzum-worker

[Install]
WantedBy=multi-user.target
