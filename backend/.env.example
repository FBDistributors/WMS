DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/wms
SECRET_KEY=change_me
# CORS: * = barcha originlar. Bo'sh qoldirsangiz — kod ichidagi defaultlar (Vercel + fbwarehouse.uz + tauri.localhost).
# VPS da desktop (Tauri) uchun kamida api/www yoki * kerak; keyin: systemctl restart wms
# Misol: CORS_ORIGINS=https://www.fbwarehouse.uz,https://api.fbwarehouse.uz,http://tauri.localhost,https://tauri.localhost
CORS_ORIGINS=*
PORT=10000

# SmartUp — "Smartup'dan yangilash" (mahsulotlar). VPS da Render env bilan moslang; bo‘lmasa sinxron yiqiladi.
# inventory_client: https://github.com/...  — asosan SMARTUP_BASIC_USER / SMARTUP_BASIC_PASS majburiy.
# SMARTUP_INVENTORY_EXPORT_URL default: smartup.online .../inventory$export (o'zgartirish kamdan-kam)
SMARTUP_INVENTORY_EXPORT_URL=
SMARTUP_BASIC_USER=
SMARTUP_BASIC_PASS=
# mfm/movement$export: Postman header project_code bilan bir xil bo'lishi kerak (odatda trade).
SMARTUP_PROJECT_CODE=trade
# Postman filial_id — VPS /etc/wms/api.env da shu qiymat
SMARTUP_FILIAL_ID=
# Tashkiliy harakat (mfm/movement$export): modified_on oralig'i (server qisqa so'rovni kengaytirishi mumkin).
# Default lookback: SMARTUP_MFM_SYNC_LOOKBACK_DAYS (default 120).
# begin_created_on/end_created_on ham to'ldirish: SMARTUP_MFM_EXPORT_FILL_CREATED_RANGE=true
SMARTUP_MFM_MOVEMENT_EXPORT_OMIT_DATES=false
SMARTUP_MFM_EXPORT_FILL_CREATED_RANGE=
SMARTUP_MFM_SYNC_LOOKBACK_DAYS=120
# Sanani qaysi maydonga yozish: modified | created | both
# Postman begin_created_on ishlatsa: created. 0 qator bo'lsa API avtomatik created bilan qayta urinadi.
SMARTUP_MFM_DATE_FILTER_MODE=modified
# VPS diagnostika: journalctl -u wms-api -n 200 | findstr /i "mfm movement WMS diller"
# Ba'zi SmartUp versiyalari body da \"status\" bo'lsa bo'sh javob beradi — default: status yuborilmaydi.
# Yoqish: SMARTUP_MFM_MOVEMENT_EXPORT_SEND_STATUS=true va SMARTUP_MFM_MOVEMENT_EXPORT_STATUS=W
SMARTUP_MFM_MOVEMENT_EXPORT_SEND_STATUS=
SMARTUP_MFM_MOVEMENT_EXPORT_STATUS=
# Flat movement$export: qatorlarni guruhlash tartibi (vergul bilan). Bir yetkazish raqami — bir nechta movement_id bo'lsa:
# SMARTUP_MFM_FLAT_GROUP_BY_KEYS=delivery_number,external_id,movement_id,movement_unit_id
SMARTUP_MFM_FLAT_GROUP_BY_KEYS=
# Boshqa SmartUp integratsiyalar (buyurtmalar, movement) uchun qo'shimcha: render.yaml / loyiha hujjatlari

# Seed base demo data
SEED_ON_START=false

# Seed WMS role users (disabled by default)
SEED_USERS_ON_START=false
SEED_WA_USERNAME=wa_admin
SEED_WA_PASSWORD=replace_with_strong_password
SEED_SUP_USERNAME=wh_supervisor
SEED_SUP_PASSWORD=replace_with_strong_password
SEED_PICK_USERNAME=wh_picker
SEED_PICK_PASSWORD=replace_with_strong_password
SEED_REC_USERNAME=wh_receiver
SEED_REC_PASSWORD=replace_with_strong_password
SEED_INV_USERNAME=wh_inventory
SEED_INV_PASSWORD=replace_with_strong_password

# Optional admin seed (legacy)
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=replace_with_strong_password
ADMIN_ROLE=warehouse_admin

# FCM (Push notifications) — choose one method:
# 1) FIREBASE_SERVICE_ACCOUNT_JSON: full service-account JSON as one-line string
# 2) FIREBASE_SERVICE_ACCOUNT_JSON_B64: base64-encoded JSON
# 3) GOOGLE_APPLICATION_CREDENTIALS: absolute path to service-account json file
# Backward-compatible aliases also supported:
#   FIREBASE_SERVICE_ACCOUNT, FIREBASE_CREDENTIALS_JSON,
#   FIREBASE_SERVICE_ACCOUNT_B64, FIREBASE_CREDENTIALS_JSON_B64,
#   GOOGLE_APPLICATION_CREDENTIALS_PATH
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_APPLICATION_CREDENTIALS=
